# ==============================================================================
# TikTok 越南市場 AI 成長與自動化發布系統 (.env.example)
# 注意：請複製為 .env 並在本地設定，切勿將真實 Token / Session 提交至 Git！
# ==============================================================================

# 系統與環境設定
APP_ENV=development
TIMEZONE=Asia/Taipei
SQLITE_DB_PATH=data/autotok_state.db
EXPORT_BASE_DIR=artifacts/manual_exports

# 安全閘門：預設為 false，禁止任何真實外部發布！
# 必須同時具備使用者明確授權並設為 true，才允許非 dry-run 執行
ALLOW_LIVE_PUBLISH=false

# 預設使用的發布通道 Adapter
# 可選值: mock | official_api | autotok_candidate | manual_export
DEFAULT_UPLOADER_ADAPTER=mock

# ------------------------------------------------------------------------------
# TikTok Official Content Posting API 設定 (official_api adapter)
# ------------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# 照片輪播 PULL_FROM_URL 必須使用已在 TikTok Developer Portal 驗證網域的公開 HTTPS 前綴
TIKTOK_VERIFIED_IMAGE_URL_PREFIX=
# 是否已通過 TikTok 官方 App Audit（未通過審核僅允許 SELF_ONLY 私密發布）
TIKTOK_APP_AUDITED=false

# ------------------------------------------------------------------------------
# ChatGPT / Codex CLI 圖像生成模型設定
# ------------------------------------------------------------------------------
CODEX_MODEL=gpt-6-sol

# ------------------------------------------------------------------------------
# Notion 資料庫設定 (Phase 2/4 整合預留，禁止在未授權下清除歷史資料)
# ------------------------------------------------------------------------------
NOTION_TOKEN=
NOTION_DATABASE_ID=f1bc34396f154e62bca90c9deea19d7a
NOTION_DATA_SOURCE_ID=4d575a73-4f98-4ff6-b3f8-da68c40c7125
